# Copy this file to .env and fill in your local values.
# Never commit .env (it is in .gitignore).

# Local PostgreSQL connection.
# With Docker Compose (compose.yaml) the port is 5433: jdbc:postgresql://localhost:5433/pendla
DB_URL=jdbc:postgresql://localhost:5432/pendla
DB_USERNAME=pendla
DB_PASSWORD=change-me

# Secret that signs the login tokens (JWT). At least 32 characters, random and never shared.
# One way to generate it: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
